# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit a real .env.
# Every variable is documented in docs/ENVIRONMENT.md.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-64
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
API_PUBLIC_URL=http://localhost:8000

# --- Database (plain PostgreSQL) -------------------------------------------
DATABASE_URL=postgres://geofencing:geofencing@localhost:5432/geofencing
DATABASE_CONN_MAX_AGE=60

# --- Deploy-time superuser --------------------------------------------------
# Read by `manage.py ensure_superuser`, which the Docker CMD runs on every boot.
# The command is idempotent: once the admin exists it reports and exits 0.
# NOTE: this project has no `username` field - email is the login. A
# DJANGO_SUPERUSER_USERNAME variable is ignored.
# Leave these unset to skip the step entirely (the CMD passes --skip-if-unset).
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-before-deploying
# Optional display name; defaults to the local part of the email.
DJANGO_SUPERUSER_NAME=Site Operator

# --- Redis / Celery ---------------------------------------------------------
# Leave REDIS_URL and CACHE_URL empty in development if you have no Redis: the
# development settings then use an in-process cache. Celery still needs a real
# broker. In production Redis is required - throttle counters must be shared
# across worker processes to mean anything.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
STALE_SCAN_INTERVAL_SECONDS=60

# --- Authentication ---------------------------------------------------------
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- CORS / CSRF (the PWA origin) ------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- API limits -------------------------------------------------------------
API_PAGE_SIZE=25
THROTTLE_RATE_AUTH=20/min
THROTTLE_RATE_LOCATION_UPDATE=60/min
THROTTLE_RATE_READ=240/min
THROTTLE_RATE_WRITE=60/min
DATA_UPLOAD_MAX_MEMORY_SIZE=262144

# --- Geofence geometry ------------------------------------------------------
MIN_RADIUS_M=10
MAX_RADIUS_M=50000
MAX_GEOFENCE_AREA_KM2=500
DEFAULT_ENTRY_BUFFER_M=0
DEFAULT_EXIT_BUFFER_M=40

# --- GPS accuracy -----------------------------------------------------------
MAX_ACCEPTABLE_ACCURACY_M=50
HARD_REJECT_ACCURACY_M=1000
ACCURACY_MARGIN_FACTOR=1.0
ACCURACY_MARGIN_CAP_M=150

# --- Hysteresis / debouncing -------------------------------------------------
REQUIRED_INSIDE_READINGS=2
REQUIRED_OUTSIDE_READINGS=3
STREAK_MAX_GAP_SECONDS=300

# --- Freshness ---------------------------------------------------------------
STALE_AFTER_SECONDS=300
MAX_LOCATION_AGE_SECONDS=3600
MAX_CLOCK_SKEW_SECONDS=120
RECOMMENDED_PING_INTERVAL_SECONDS=60

# --- Anomaly detection --------------------------------------------------------
MAX_PLAUSIBLE_SPEED_KMH=300
JUMP_DISTANCE_M=5000
JUMP_WINDOW_SECONDS=60
STATIONARY_TOLERANCE_M=1
STATIONARY_MIN_SECONDS=1800
STATIONARY_MIN_READINGS=10
MAX_UPDATES_PER_MINUTE=30

# --- Retention (privacy) -------------------------------------------------------
LOCATION_HISTORY_RETENTION_DAYS=30
PRESENCE_EVENT_RETENTION_DAYS=365
ANOMALY_RETENTION_DAYS=90

# --- Production only -----------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# DJANGO_ADMIN_URL=some-unguessable-path/
