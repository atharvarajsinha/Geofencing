# API Endpoint Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Location tracking default settings
NEXT_PUBLIC_LOCATION_THROTTLE_MS=15000
NEXT_PUBLIC_MIN_ACCURACY_METERS=150

# Fallback map centre "lat,lng", used ONLY when the device position is
# unknown (permission denied, no GPS). The map opens at a wide zoom there
# so it never looks like a precise-but-wrong location.
NEXT_PUBLIC_DEFAULT_MAP_CENTER=20.5937,78.9629
